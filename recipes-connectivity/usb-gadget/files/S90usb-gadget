#!/bin/sh
# USB Gadget RNDIS - IP: 192.168.20.2
# Host (Windows): Configure adapter IP 192.168.20.1/24, then ssh root@192.168.20.2
# Host (Linux): sudo ip addr add 192.168.20.1/24 dev usb0 && ssh root@192.168.20.2

start() {
    mountpoint -q /sys/kernel/config || mount -t configfs configfs /sys/kernel/config
    cd /sys/kernel/config/usb_gadget/
    mkdir -p g && cd g
    echo 0x1d6b > idVendor
    echo 0x0104 > idProduct
    echo 0x0100 > bcdDevice
    echo 0x0200 > bcdUSB
    mkdir -p strings/0x409
    echo "colorcreator001" > strings/0x409/serialnumber
    echo "ColorCreator" > strings/0x409/manufacturer
    echo "ColorCreator USB" > strings/0x409/product
    mkdir -p configs/c.1/strings/0x409
    echo "RNDIS" > configs/c.1/strings/0x409/configuration
    echo 250 > configs/c.1/MaxPower

    # Use RNDIS for Windows compatibility
    mkdir -p functions/rndis.usb0

    # Configure RNDIS for Windows
    echo "RNDIS" > functions/rndis.usb0/os_desc/interface.rndis/compatible_id
    echo "5162001" > functions/rndis.usb0/os_desc/interface.rndis/sub_compatible_id

    ln -s functions/rndis.usb0 configs/c.1/
    ln -s configs/c.1 os_desc/

    ls /sys/class/udc > UDC
    sleep 2
    ifconfig usb0 192.168.20.2 netmask 255.255.255.0 up
    echo "USB RNDIS: ssh root@192.168.20.2 (Windows: set adapter IP to 192.168.20.1/24)"
}

stop() {
    ifconfig usb0 down 2>/dev/null
    cd /sys/kernel/config/usb_gadget/g 2>/dev/null && {
        echo "" > UDC
        rm -f configs/c.1/rndis.usb0 2>/dev/null
        rm -f os_desc/c.1 2>/dev/null
        rmdir configs/c.1/strings/0x409 configs/c.1 functions/rndis.usb0 strings/0x409 2>/dev/null
        cd ..; rmdir g 2>/dev/null
    }
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; sleep 1; start ;;
    *) echo "Usage: $0 {start|stop|restart}" ;;
esac
